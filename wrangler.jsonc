{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xedruo-platform",
  "main": "worker/index.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "vars": {
    "AUTH_ISSUER": "https://xedruo.com",
    "AUTH_APP_ORIGIN": "https://xedruo.com",
    "XEDRUO_GOOGLE_REDIRECT_URI": "https://xedruo.com/api/auth/google/callback"
  }
  // Add this only at cutover (see docs/cloudflare-migration.md):
  // , "routes": [{ "pattern": "xedruo.com", "custom_domain": true }]
}
